---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');

const categoryMeta = {
  wirtschaft: {
    label: 'WIRTSCHAFT',
    color: '#7A5A13',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5v4"/><rect width="4" height="6" x="7" y="9" rx="1"/><path d="M9 15v2"/><path d="M17 3v2"/><rect width="4" height="8" x="15" y="5" rx="1"/><path d="M17 13v3"/></svg>',
  },

  politik: {
    label: 'POLITIK',
    color: '#1F4C72',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18"/><path d="m19 8 3 8a5 5 0 0 1-6 0zV7"/><path d="M3 7h1a17 17 0 0 0 8-2 17 17 0 0 0 8 2h1"/><path d="m5 8 3 8a5 5 0 0 1-6 0zV7"/><path d="M7 21h10"/></svg>',
  },

  'umwelt-klima': {
    label: 'UMWELT & KLIMA',
    color: '#315E3A',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 10v.2A3 3 0 0 1 8.9 16H5a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0Z"/><path d="M7 16v6"/><path d="M13 19v3"/><path d="M12 19h8.3"/></svg>',
  },

  sport: {
    label: 'SPORT',
    color: '#7A2A22',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 14.66v1.626"/><path d="M14 14.66v1.626"/><path d="M18 9h1.5"/><path d="M4 22h16"/><path d="M6 9a6 6 0 0 0 12 0V3"/></svg>',
  },

  'geschichte-kultur': {
    label: 'GESCHICHTE & KULTUR',
    color: '#5B3D22',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 18v-7"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="M3 22h18"/><path d="M6 18v-7"/></svg>',
  },

  'technik-wissenschaft': {
    label: 'TECHNIK & WISSENSCHAFT',
    color: '#202020',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9"/><path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9"/></svg>',
  },

  'mensch-tier': {
    label: 'MENSCH & TIER',
    color: '#743846',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m10 16 1.5 1.5"/><path d="m14 8-1.5-1.5"/><path d="M2 15c6.667-6 13.333 0 20-6"/></svg>',
  },

  tagebuch: {
    label: 'TAGEBUCH',
    color: '#746A60',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13.4 2H6a2 2 0 0 0-2 2v16"/><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/></svg>',
  },
};

const articleItems = articles
  .map((article) => {
    const meta = categoryMeta[article.data.category] ?? {
      label: article.data.category.toUpperCase(),
      color: '#7a7168',
    };

    return {
      title: article.data.title,
      description: article.data.description,
      date: article.data.date,
      author: article.data.author,
      category: meta.label,
      color: meta.color,
      icon: meta.icon,
      link: `/artikel/${article.id.replace(/\.md$/, '')}`,
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout>
  <main class="page">
    <header class="topbar">
      <a href="/" class="brand">Project Byline</a>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Darstellung wechseln">
        <span class="theme-icon theme-sun">☀</span>
        <span class="theme-icon theme-moon">☾</span>
      </button>

      <details class="menu-wrap">
        <summary class="menu" aria-label="Menü">
          <span></span>
          <span></span>
          <span></span>
        </summary>

        <nav class="menu-panel">
          <a href="/suche">Entdecken</a>
          <a href="/artikel">Alle Artikel</a>
          <a href="/autoren">Autor:innen</a>
          <a href="/ueber">Über Project Byline</a>
        </nav>
      </details>
    </header>

    <section class="hero">
      <p class="eyebrow">Archiv</p>
      <h1>Entdecken</h1>
      <p>
        Drei zufällige Beiträge aus dem Archiv. Nicht suchen, sondern finden.
      </p>
    </section>

    <section class="action-row">
      <button class="random-button" type="button" id="randomButton">
        Neue Auswahl
      </button>
    </section>

    <section class="random-grid" id="randomGrid">
      {articleItems.map((article) => (
        <a
          class="random-card"
          href={article.link}
          data-random-article
          data-category={article.category}
          data-date={article.date}
          data-author={article.author}
          data-title={article.title}
          data-description={article.description}
          style={`--category-color:${article.color};`}
        >
          <p class="meta">
            <span class="meta-topic">
              <span class="meta-icon" set:html={article.icon} />
              <span>{article.category}</span>
            </span>
            <span class="meta-separator">·</span>
            <span>{article.date}</span>
            <span class="meta-separator">·</span>
            <span>{article.author}</span>
          </p>

          <h2>{article.title}</h2>

          <p class="card-description">
            {article.description}
          </p>

          <span class="read-more">Lesen →</span>
        </a>
      ))}
    </section>

    <script is:inline>
      const cards = Array.from(document.querySelectorAll('[data-random-article]'));
      const button = document.getElementById('randomButton');

      function shuffle(array) {
        const copy = [...array];

        for (let i = copy.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [copy[i], copy[j]] = [copy[j], copy[i]];
        }

        return copy;
      }

      function showRandomArticles() {
        const selected = shuffle(cards).slice(0, 3);

        cards.forEach((card) => {
          card.style.display = 'none';
        });

        selected.forEach((card) => {
          card.style.display = 'flex';
        });
      }

      button?.addEventListener('click', showRandomArticles);

      showRandomArticles();
    </script>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap');

  :global(body) {
    margin: 0;
    background: #f4f1ec;
    color: #151515;
    font-family: 'Inter', sans-serif;
  }

  .page {
    min-height: 100vh;
    padding: 24px 34px 60px;
  }

  .topbar {
    height: 42px;
    max-width: 1500px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid rgba(0,0,0,0.11);
  }

  .brand {
    font-family: 'DM Serif Display', serif;
    font-size: 1.28rem;
    letter-spacing: -0.02em;
    color: #151515;
    text-decoration: none;
  }

  .theme-toggle {
    width: 42px;
    height: 26px;
    border: 1px solid rgba(0,0,0,0.13);
    border-radius: 999px;
    background: rgba(255,255,255,0.35);
    color: #151515;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    padding: 0;
    line-height: 1;
    justify-self: center;
    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      color 0.35s ease,
      transform 0.18s ease;
  }

  .theme-toggle:hover {
    transform: translateY(-1px);
  }

  .theme-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .theme-sun {
    opacity: 1;
    transform: translateY(0) rotate(0);
  }

  .theme-moon {
    opacity: 0;
    transform: translateY(-10px) rotate(30deg);
  }

  .menu-wrap {
    position: relative;
    justify-self: end;
  }

  .menu-wrap summary {
    list-style: none;
  }

  .menu-wrap summary::-webkit-details-marker {
    display: none;
  }

  .menu {
    width: 34px;
    height: 26px;
    border: 0;
    background: transparent;
    display: grid;
    gap: 4px;
    cursor: pointer;
    padding: 3px;
  }

  .menu span {
    display: block;
    height: 1.5px;
    background: #151515;
    border-radius: 999px;
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: 42px;
    z-index: 20;
    width: 220px;
    padding: 10px;
    border-radius: 16px;
    background: rgba(244,241,236,0.96);
    border: 1px solid rgba(0,0,0,0.12);
    box-shadow: 0 18px 45px rgba(0,0,0,0.10);
    backdrop-filter: blur(12px);
  }

  .menu-panel a {
    display: block;
    padding: 12px;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: #151515;
    text-decoration: none;
  }

  .menu-panel a:hover {
    background: rgba(0,0,0,0.06);
  }

  .hero {
    max-width: 1500px;
    margin: 0 auto;
    padding: 62px 0 28px;
  }

  .eyebrow {
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.62rem;
    font-weight: 700;
    color: #7a7168;
  }

  h1 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(3.8rem, 7vw, 6.8rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin: 0;
  }

  .hero p {
    max-width: 720px;
    margin: 24px 0 0;
    color: #6b6258;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .action-row {
    max-width: 1500px;
    margin: 0 auto 22px;
    display: flex;
    justify-content: flex-end;
  }

  .random-button {
    border: 1px solid rgba(0,0,0,0.12);
    background: rgba(255,255,255,0.38);
    border-radius: 999px;
    padding: 12px 18px;
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 26px rgba(0,0,0,0.035);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }

  .random-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(0,0,0,0.08);
    background: rgba(255,255,255,0.55);
  }

  .random-grid {
    max-width: 1500px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .random-card {
    display: none;
    min-height: 230px;
    padding: 26px;
    border-radius: 20px;
    background: rgba(255,255,255,0.40);
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 12px 30px rgba(0,0,0,0.045);
    color: #151515;
    text-decoration: none;
    flex-direction: column;
    justify-content: space-between;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .random-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 38px rgba(0,0,0,0.08);
  }

  .meta {
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.66rem;
    font-weight: 700;
    color: #7a7168;
  }

  .meta span:first-child {
    color: var(--category-color);
  }

  .meta-separator {
    color: rgba(0,0,0,0.28);
  }

  .random-card h2 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0 0 12px;
    font-weight: 400;
  }

  .card-description {
    color: #5f5750;
    line-height: 1.5;
    margin: 0;
    font-size: 0.98rem;
  }

  .read-more {
    margin-top: 24px;
    font-weight: 800;
    font-size: 0.95rem;
    align-self: flex-end;
  }

  :global(html[data-theme='dark']) .topbar {
    border-bottom-color: rgba(238,231,220,0.13);
  }

  :global(html[data-theme='dark']) .brand,
  :global(html[data-theme='dark']) h1 {
    color: #eee7dc;
  }

  :global(html[data-theme='dark']) .hero p,
  :global(html[data-theme='dark']) .card-description {
    color: #b6aa9a;
  }

  :global(html[data-theme='dark']) .eyebrow {
    color: #d6b982;
  }

  :global(html[data-theme='dark']) .theme-toggle {
    background: rgba(238,231,220,0.08);
    border-color: rgba(238,231,220,0.22);
    color: #eee7dc;
  }

  :global(html[data-theme='dark']) .theme-sun {
    opacity: 0;
    transform: translateY(10px) rotate(-30deg);
  }

  :global(html[data-theme='dark']) .theme-moon {
    opacity: 1;
    transform: translateY(0) rotate(0);
  }

  :global(html[data-theme='dark']) .menu span {
    background: #eee7dc;
  }

  :global(html[data-theme='dark']) .menu-panel {
    background: rgba(23,22,20,0.96);
    border-color: rgba(238,231,220,0.14);
    box-shadow: 0 18px 45px rgba(0,0,0,0.35);
  }

  :global(html[data-theme='dark']) .menu-panel a {
    color: #eee7dc;
  }

  :global(html[data-theme='dark']) .menu-panel a:hover {
    background: rgba(238,231,220,0.08);
  }

  :global(html[data-theme='dark']) .random-button {
    background: rgba(238,231,220,0.08);
    border-color: rgba(238,231,220,0.16);
    color: #eee7dc;
    box-shadow: 0 18px 44px rgba(0,0,0,0.26);
  }

  :global(html[data-theme='dark']) .random-button:hover {
    background: rgba(238,231,220,0.12);
  }

  :global(html[data-theme='dark']) .random-card {
    background:
      linear-gradient(135deg, rgba(255,255,255,0.075), rgba(0,0,0,0.18)),
      #211f1b;
    border-color: rgba(238,231,220,0.14);
    box-shadow: 0 18px 44px rgba(0,0,0,0.28);
    color: #eee7dc;
  }

  :global(html[data-theme='dark']) .random-card h2,
  :global(html[data-theme='dark']) .read-more {
    color: #eee7dc;
  }

  :global(html[data-theme='dark']) .meta-separator {
    color: rgba(238,231,220,0.28);
  }

  @media (max-width: 1000px) {
    .random-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .page {
      padding: 18px;
    }

    .hero {
      padding: 44px 0 26px;
    }

    h1 {
      font-size: clamp(3.3rem, 17vw, 5rem);
      line-height: 0.94;
      letter-spacing: -0.025em;
    }

    .action-row {
      justify-content: flex-start;
    }

    .random-card {
      min-height: auto;
      padding: 24px;
    }
  }
</style>