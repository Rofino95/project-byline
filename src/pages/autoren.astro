---
import Layout from '../layouts/Layout.astro';

const authors = [
  {
    initials: 'RZ',
    name: 'Robin Zimmer',
    role: 'Redaktion, Technik, Wirtschaft und Analyse',
  },
];
---

<Layout>
  <main class="page">
    <header class="topbar">
      <a href="/" class="brand">Project Byline</a>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Darstellung wechseln">
        <span class="theme-icon theme-sun">☀</span>
        <span class="theme-icon theme-moon">☾</span>
      </button>

      <details class="menu-wrap">
        <summary class="menu" aria-label="Menü">
          <span></span>
          <span></span>
          <span></span>
        </summary>

        <nav class="menu-panel">
          <a href="/suche">Entdecken</a>
          <a href="/artikel">Alle Artikel</a>
          <a href="/autoren">Autor:innen</a>
          <a href="/ueber">Über Project Byline</a>
        </nav>
      </details>
    </header>

    <section class="hero">
      <p class="eyebrow">Project Byline</p>
      <h1>Autor:innen</h1>
      <p class="description">
        Eine Übersicht der Kürzel, die in den Artikeln von Project Byline verwendet werden.
      </p>
    </section>

    <section class="authors-list">
      {authors.map((author) => (
        <a class="author-card" href={`/autoren/${author.initials.toLowerCase()}`}>
          <div class="initials">{author.initials}</div>

          <div>
            <h2>{author.name}</h2>
            <p>{author.role}</p>
          </div>
        </a>
      ))}
    </section>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap');

  :global(body) {
    margin: 0;
    background: #f4f1ec;
    color: #151515;
    font-family: 'Inter', sans-serif;
  }

  .page {
    min-height: 100vh;
    padding: 24px 34px 60px;
  }

  .topbar {
    height: 42px;
    max-width: 1500px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid rgba(0,0,0,0.11);
  }

  .back-link {
    justify-self: end;
    text-decoration: none;
    color: #7a7168;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .brand {
    font-family: 'DM Serif Display', serif;
    font-size: 1.25rem;
    text-decoration: none;
    color: #151515;
    letter-spacing: -0.02em;
  }

  .hero {
    max-width: 1500px;
    margin: 0 auto 48px;
    padding-top: 62px;
  }

  .eyebrow {
    margin: 0 0 14px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.68rem;
    font-weight: 700;
    color: #7a7168;
  }

  h1 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(4rem, 8vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    margin: 0;
  }

  .description {
    max-width: 620px;
    margin: 24px 0 0;
    font-family: 'DM Serif Display', serif;
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.7;
    color: #6b6258;
    padding-left: 22px;
    border-left: 2px solid rgba(0,0,0,0.16);
  }

  .authors-list {
    max-width: 1500px;
    margin: 0 auto;
    display: grid;
    gap: 16px;
  }

  .author-card {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 24px;
    align-items: center;
    padding: 24px;
    border-radius: 18px;
    background: rgba(255,255,255,0.35);
    border: 1px solid rgba(0,0,0,0.08);
    text-decoration: none;
    color: #151515;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .author-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 38px rgba(0,0,0,0.08);
  }

  .initials {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #151515;
    color: #f4f1ec;
    font-family: 'DM Serif Display', serif;
    font-size: 1.8rem;
    letter-spacing: -0.04em;
  }

  .author-card h2 {
    margin: 0 0 6px;
    font-family: 'DM Serif Display', serif;
    font-size: 2rem;
    letter-spacing: -0.04em;
  }

  .author-card p {
    margin: 0;
    color: #6b6258;
    line-height: 1.6;
  }

  @media (max-width: 650px) {
    .author-card {
      grid-template-columns: 1fr;
    }
  }

.theme-toggle {
  width: 42px;
  height: 26px;
  border: 1px solid rgba(0,0,0,0.13);
  border-radius: 999px;
  background: rgba(255,255,255,0.35);
  color: #151515;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  padding: 0;
  line-height: 1;
  justify-self: center;
  transition:
    background 0.35s ease,
    border-color 0.35s ease,
    color 0.35s ease,
    transform 0.18s ease;
}

.theme-toggle:hover {
  transform: translateY(-1px);
}

.theme-icon {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.78rem;
  transition:
    opacity 0.35s ease,
    transform 0.35s ease;
}

.theme-sun {
  opacity: 1;
  transform: translateY(0) rotate(0);
}

.theme-moon {
  opacity: 0;
  transform: translateY(-10px) rotate(30deg);
}

:global(html[data-theme='dark']) .theme-sun {
  opacity: 0;
  transform: translateY(10px) rotate(-30deg);
}

:global(html[data-theme='dark']) .theme-moon {
  opacity: 1;
  transform: translateY(0) rotate(0);
}

:global(html[data-theme='dark']) .topbar {
  border-bottom-color: rgba(238,231,220,0.13);
}

:global(html[data-theme='dark']) .brand,
:global(html[data-theme='dark']) h1 {
  color: #eee7dc;
}

:global(html[data-theme='dark']) .back-link,
:global(html[data-theme='dark']) .eyebrow {
  color: #d6b982;
}

:global(html[data-theme='dark']) .description,
:global(html[data-theme='dark']) .author-card p {
  color: #b6aa9a;
}

:global(html[data-theme='dark']) .description {
  border-left-color: rgba(214,185,130,0.45);
}

:global(html[data-theme='dark']) .theme-toggle {
  background: rgba(238,231,220,0.08);
  border-color: rgba(238,231,220,0.22);
  color: #eee7dc;
}

:global(html[data-theme='dark']) .author-card {
  background:
    linear-gradient(135deg, rgba(255,255,255,0.075), rgba(0,0,0,0.18)),
    #211f1b;
  border-color: rgba(238,231,220,0.14);
  box-shadow: 0 18px 44px rgba(0,0,0,0.28);
  color: #eee7dc;
}

:global(html[data-theme='dark']) .initials {
  background: #eee7dc;
  color: #171614;
}

:global(html[data-theme='dark']) .author-card h2 {
  color: #eee7dc;
}

.menu-wrap {
  position: relative;
  justify-self: end;
}

.menu-wrap summary {
  list-style: none;
}

.menu-wrap summary::-webkit-details-marker {
  display: none;
}

.menu {
  width: 34px;
  height: 26px;
  border: 0;
  background: transparent;
  display: grid;
  gap: 4px;
  cursor: pointer;
  padding: 3px;
}

.menu span {
  display: block;
  height: 1.5px;
  background: #151515;
  border-radius: 999px;
}

.menu-panel {
  position: absolute;
  right: 0;
  top: 42px;
  z-index: 20;
  width: 220px;
  padding: 10px;
  border-radius: 16px;
  background: rgba(244,241,236,0.96);
  border: 1px solid rgba(0,0,0,0.12);
  box-shadow: 0 18px 45px rgba(0,0,0,0.10);
  backdrop-filter: blur(12px);
}

.menu-panel a {
  display: block;
  padding: 12px;
  border-radius: 10px;
  font-size: 0.92rem;
  font-weight: 600;
  color: #151515;
  text-decoration: none;
}

.menu-panel a:hover {
  background: rgba(0,0,0,0.06);
}

</style>