---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');

const categoryColors = {
  wirtschaft: '#7A5A13',
  politik: '#1F4C72',
  'umwelt-klima': '#315E3A',
  sport: '#7A2A22',
  'geschichte-kultur': '#5B3D22',
  'technik-wissenschaft': '#202020',
  'mensch-tier': '#743846',
  tagebuch: '#746A60',
};

const sortedArticles = articles.sort(
  (a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
);
---

<Layout>
  <main class="page">
    <header class="topbar">
      <a href="/" class="brand">Project Byline</a>

      <details class="menu-wrap">
        <summary class="menu" aria-label="Menü">
          <span></span>
          <span></span>
          <span></span>
        </summary>

        <nav class="menu-panel">
          <a href="/suche">Suche</a>
          <a href="/artikel">Alle Artikel</a>
          <a href="/autoren">Autor:innen</a>
          <a href="/ueber">Über Project Byline</a>
        </nav>
      </details>
    </header>

    <section class="hero">
      <p class="eyebrow">Archiv</p>

      <h1>Alle Artikel</h1>

      <p class="description">
        Eine Übersicht aller veröffentlichten Beiträge auf Project Byline.
      </p>
    </section>

    <section class="search-wrap">
      <input
        type="text"
        id="searchInput"
        placeholder="Artikel suchen..."
      />
    </section>

    <section class="article-list" id="articleList">
      {sortedArticles.map((article) => (
        <a
          class="article-card"
          href={`/artikel/${article.id.replace(/\.md$/, '')}`}
          data-title={article.data.title.toLowerCase()}
          data-description={article.data.description.toLowerCase()}
          data-category={article.data.category.toLowerCase()}
        >
          <p
            class="meta"
            style={`color:${categoryColors[article.data.category]}`}
          >
            {article.data.category.toUpperCase()} · {article.data.date} · {article.data.author}
          </p>

          <h2>{article.data.title}</h2>

          <p class="card-description">
            {article.data.description}
          </p>

          <span class="read-more">→ Lesen</span>
        </a>
      ))}
    </section>

    <script is:inline>
      const searchInput = document.getElementById('searchInput');
      const cards = document.querySelectorAll('.article-card');

      searchInput.addEventListener('input', () => {
        const value = searchInput.value.toLowerCase();

        cards.forEach((card) => {
          const title = card.dataset.title || '';
          const description = card.dataset.description || '';
          const category = card.dataset.category || '';

          const match =
            title.includes(value) ||
            description.includes(value) ||
            category.includes(value);

          card.style.display = match ? 'block' : 'none';
        });
      });
    </script>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap');

  :global(body) {
    margin: 0;
    background: #f4f1ec;
    color: #151515;
    font-family: 'Inter', sans-serif;
  }

  .page {
    min-height: 100vh;
    padding: 24px;
  }

  .topbar {
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(0,0,0,0.11);
  }

  .brand {
    font-family: 'DM Serif Display', serif;
    font-size: 1.28rem;
    letter-spacing: -0.02em;
    color: #151515;
    text-decoration: none;
  }

  .menu-wrap {
    position: relative;
  }

  .menu-wrap summary {
    list-style: none;
  }

  .menu-wrap summary::-webkit-details-marker {
    display: none;
  }

  .menu {
    width: 34px;
    height: 26px;
    border: 0;
    background: transparent;
    display: grid;
    gap: 4px;
    cursor: pointer;
    padding: 3px;
  }

  .menu span {
    display: block;
    height: 1.5px;
    background: #151515;
    border-radius: 999px;
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: 42px;
    z-index: 20;
    width: 220px;
    padding: 10px;
    border-radius: 16px;
    background: rgba(244,241,236,0.96);
    border: 1px solid rgba(0,0,0,0.12);
    box-shadow: 0 18px 45px rgba(0,0,0,0.10);
    backdrop-filter: blur(12px);
  }

  .menu-panel a {
    display: block;
    padding: 12px;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: #151515;
    text-decoration: none;
  }

  .menu-panel a:hover {
    background: rgba(0,0,0,0.06);
  }

  .hero {
    max-width: 1200px;
    margin: 0 auto 44px;
    padding: 54px 0 34px;
  }

  .eyebrow {
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.62rem;
    font-weight: 700;
    color: #7a7168;
  }

  h1 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(4rem, 8vw, 7rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .description {
    max-width: 700px;
    margin-top: 22px;
    line-height: 1.7;
    color: #6b6258;
    font-size: 1.15rem;
  }

  .search-wrap {
    max-width: 1200px;
    margin: 0 auto 34px;
  }

  .search-wrap input {
    width: 100%;
    border: 1px solid rgba(0,0,0,0.10);
    background: rgba(255,255,255,0.38);
    border-radius: 18px;
    padding: 18px 22px;
    font-size: 1rem;
    font-family: 'Inter', sans-serif;
    outline: none;
    box-sizing: border-box;
  }

  .article-list {
    max-width: 1200px;
    margin: 0 auto;
  }

  .article-card {
    display: block;
    padding: 34px 0;
    border-top: 1px solid rgba(0,0,0,0.10);
    color: #151515;
    text-decoration: none;
    transition: opacity 0.18s ease;
  }

  .article-card:hover {
    opacity: 0.72;
  }

  .meta {
    margin: 0 0 16px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.68rem;
    font-weight: 700;
  }

  h2 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    margin: 0 0 18px;
  }

  .card-description {
    max-width: 760px;
    line-height: 1.7;
    color: #5f5750;
    margin: 0 0 18px;
    font-size: 1.05rem;
  }

  .read-more {
    font-weight: 700;
    font-size: 0.95rem;
  }

  @media (max-width: 700px) {
    .page {
      padding: 18px;
    }

    h2 {
      font-size: 2.4rem;
    }
  }
</style>