---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');

const articleItems = articles
  .map((article) => ({
    title: article.data.title,
    description: article.data.description,
    date: article.data.date,
    category: article.data.category,
    author: article.data.author,
    link: `/artikel/${article.id.replace(/\.md$/, '')}`,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const topics = [
  {
    title: 'Wirtschaft',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-candlestick-icon lucide-chart-candlestick"><path d="M9 5v4"/><rect width="4" height="6" x="7" y="9" rx="1"/><path d="M9 15v2"/><path d="M17 3v2"/><rect width="4" height="8" x="15" y="5" rx="1"/><path d="M17 13v3"/><path d="M3 3v16a2 2 0 0 0 2 2h16"/></svg>',
    color: '#F3E3B2',
    text: '#7A5A13',
    link: '/themen/wirtschaft',
  },
  {
    title: 'Politik',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scale-icon lucide-scale"><path d="M12 3v18"/><path d="m19 8 3 8a5 5 0 0 1-6 0zV7"/><path d="M3 7h1a17 17 0 0 0 8-2 17 17 0 0 0 8 2h1"/><path d="m5 8 3 8a5 5 0 0 1-6 0zV7"/><path d="M7 21h10"/></svg>',
    color: '#C9D8E8',
    text: '#1F4C72',
    link: '/themen/politik',
  },
  {
    title: 'Umwelt & Klima',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trees-icon lucide-trees"><path d="M10 10v.2A3 3 0 0 1 8.9 16H5a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0Z"/><path d="M7 16v6"/><path d="M13 19v3"/><path d="M12 19h8.3a1 1 0 0 0 .7-1.7L18 14h.3a1 1 0 0 0 .7-1.7L16 9h.2a1 1 0 0 0 .8-1.7L13 3l-1.4 1.5"/></svg>',
    color: '#CEDDC8',
    text: '#315E3A',
    link: '/themen/umwelt-klima',
  },
  {
    title: 'Sport',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trophy-icon lucide-trophy"><path d="M10 14.66v1.626a2 2 0 0 1-.976 1.696A5 5 0 0 0 7 21.978"/><path d="M14 14.66v1.626a2 2 0 0 0 .976 1.696A5 5 0 0 1 17 21.978"/><path d="M18 9h1.5a1 1 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z"/><path d="M6 9H4.5a1 1 0 0 1 0-5H6"/></svg>',
    color: '#E4B8AE',
    text: '#7A2A22',
    link: '/themen/sport',
  },
  {
    title: 'Geschichte & Kultur',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-landmark-icon lucide-landmark"><path d="M10 18v-7"/><path d="M11.119 2.205a2 2 0 0 1 1.762 0l7.84 3.846A.5.5 0 0 1 20.5 7h-17a.5.5 0 0 1-.22-.949z"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="M3 22h18"/><path d="M6 18v-7"/></svg>',
    color: '#D8C1A8',
    text: '#5B3D22',
    link: '/themen/geschichte-kultur',
  },
  {
    title: 'Technik & Wissenschaft',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-atom-icon lucide-atom"><circle cx="12" cy="12" r="1"/><path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5Z"/><path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5Z"/></svg>',
    color: '#C9C9C6',
    text: '#202020',
    link: '/themen/technik-wissenschaft',
  },
  {
    title: 'Mensch & Tier',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dna-icon lucide-dna"><path d="m10 16 1.5 1.5"/><path d="m14 8-1.5-1.5"/><path d="M15 2c-1.798 1.998-2.518 3.995-2.807 5.993"/><path d="m16.5 10.5 1 1"/><path d="m17 6-2.891-2.891"/><path d="M2 15c6.667-6 13.333 0 20-6"/><path d="m20 9 .891.891"/><path d="M3.109 14.109 4 15"/><path d="m6.5 12.5 1 1"/><path d="m7 18 2.891 2.891"/><path d="M9 22c1.798-1.998 2.518-3.995 2.807-5.993"/></svg>',
    color: '#E7C1CB',
    text: '#743846',
    link: '/themen/mensch-tier',
  },
  {
    title: 'Tagebuch',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-notebook-pen-icon lucide-notebook-pen"><path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"/><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/></svg>',
    color: '#E8E3DC',
    text: '#746A60',
    link: '/themen/tagebuch',
  },
];
---

<Layout>
  <main class="page">
    <header class="topbar">
      <div class="brand">Project Byline</div>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Darstellung wechseln">
        <span class="theme-icon theme-sun">☀</span>
        <span class="theme-icon theme-moon">☾</span>
      </button>

      <details class="menu-wrap">
        <summary class="menu" aria-label="Menü">
          <span></span>
          <span></span>
          <span></span>
        </summary>

        <nav class="menu-panel">
          <a href="/suche">Suche</a>
          <a href="/artikel">Alle Artikel</a>
          <a href="/autoren">Autor:innen</a>
          <a href="/ueber">Über Project Byline</a>
        </nav>
      </details>
    </header>

    <section class="hero">
      <div class="hero-line"></div>
      <p class="eyebrow">Independent journalistic space</p>
      <h1>Project Byline</h1>
      <p class="subtitle">Everything in its right place</p>
    </section>

    <section class="section-head">
      <p>Dashboard</p>
    </section>

    <section class="topic-grid">
      {topics.map((topic) => (
        <a
          class="topic-card"
          href={topic.link}
          style={`--card-bg: ${topic.color}; --text: ${topic.text};`}
        >
          <span
          class="topic-icon"
          set:html={topic.icon}
          />
          <span class="topic-title">{topic.title}</span>
          <span class="topic-arrow">→</span>
        </a>
      ))}
    </section>

    <section class="daily-section">
      <div class="daily-head">
        <p>Aus dem Archiv</p>
        <h2>Zufälliger Artikel des Tages</h2>
      </div>

      {articleItems.length > 0 ? (
        <div class="daily-article-list" id="daily-article-list">
          {articleItems.map((article) => (
            <a
              class="daily-article-card"
              href={article.link}
              data-daily-article
            >
              <div>
                <p class="daily-meta">
                  {article.date} · {article.category} · {article.author}
                </p>

                <h3>{article.title}</h3>

                <p>{article.description}</p>
              </div>

              <span>Lesen →</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="daily-empty">
          Noch kein Artikel vorhanden.
        </div>
      )}
    </section>

    <script is:inline>
      function getDailyIndex(length) {
        const today = new Date();
        const key = `${today.getFullYear()}-${today.getMonth() + 1}-${today.getDate()}`;

        let hash = 0;

        for (let i = 0; i < key.length; i++) {
          hash = (hash << 5) - hash + key.charCodeAt(i);
          hash |= 0;
        }

        return Math.abs(hash) % length;
      }

      function showDailyArticle() {
        const cards = Array.from(document.querySelectorAll('[data-daily-article]'));

        if (!cards.length) return;

        cards.forEach((card) => {
          card.style.display = 'none';
        });

        const index = getDailyIndex(cards.length);
        cards[index].style.display = 'flex';
      }

      showDailyArticle();

      setInterval(showDailyArticle, 60 * 1000);
    </script>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap');

  :global(body) {
    margin: 0;
    background: #f4f1ec;
    color: #151515;
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
  }

  .page {
    min-height: 100vh;
    padding: 18px 34px 34px;
  }

  .topbar {
    height: 42px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(0,0,0,0.11);
  }

  .brand {
    font-family: 'DM Serif Display', serif;
    font-size: 1.28rem;
    letter-spacing: -0.02em;
  }

  .menu-wrap {
    position: relative;
    justify-self: end;
  }

  .menu-wrap summary {
    list-style: none;
  }

  .menu-wrap summary::-webkit-details-marker {
    display: none;
  }

  .menu {
    width: 34px;
    height: 26px;
    border: 0;
    background: transparent;
    display: grid;
    gap: 4px;
    cursor: pointer;
    padding: 3px;
  }

  .menu span {
    display: block;
    height: 1.5px;
    background: #151515;
    border-radius: 999px;
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: 42px;
    z-index: 20;
    width: 220px;
    padding: 10px;
    border-radius: 16px;
    background: rgba(244, 241, 236, 0.96);
    border: 1px solid rgba(0,0,0,0.12);
    box-shadow: 0 18px 45px rgba(0,0,0,0.10);
    backdrop-filter: blur(12px);
  }

  .menu-panel a {
    display: block;
    padding: 12px;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: #151515;
    text-decoration: none;
  }

  .menu-panel a:hover {
    background: rgba(0,0,0,0.06);
  }

  .hero {
    position: relative;
    max-width: 1500px;
    margin: 0 auto;
    padding: 52px 0 58px;
    text-align: center;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0,0,0,0.035) 1px, transparent 1px),
      linear-gradient(rgba(0,0,0,0.025) 1px, transparent 1px);
    background-size: 46px 46px;
    opacity: 0.18;
    pointer-events: none;
  }

  .hero-line {
    position: relative;
    z-index: 1;
    width: 58px;
    height: 3px;
    background: #151515;
    margin: 0 auto 18px;
    border-radius: 999px;
  }

  .eyebrow {
    position: relative;
    z-index: 1;
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.58rem;
    font-weight: 700;
    color: #6b6258;
  }

  h1 {
    position: relative;
    z-index: 1;
    font-family: 'DM Serif Display', serif;
    font-size: clamp(4.2rem, 7.4vw, 7.8rem);
    line-height: 0.82;
    margin: 0;
    letter-spacing: -0.04em;
  }

  .subtitle {
    position: relative;
    z-index: 1;
    font-family: 'DM Serif Display', serif;
    font-style: italic;
    font-size: clamp(1.15rem, 1.8vw, 2rem);
    margin: 28px 0 0;
    color: #6b6258;
  }

  .section-head {
    max-width: 1500px;
    margin: 0 auto 14px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    border-top: 1px solid rgba(0,0,0,0.12);
    padding-top: 14px;
  }

  .section-head p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.62rem;
    font-weight: 700;
    color: #7a7168;
  }

  .topic-grid {
    max-width: 1500px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .topic-card {
    position: relative;
    min-height: 128px;
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.34), rgba(0,0,0,0.035)),
      var(--card-bg);
    color: var(--text);
    text-decoration: none;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 12px 28px rgba(0,0,0,0.045);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .topic-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0,0,0,0.045) 1px, transparent 1px),
      linear-gradient(rgba(0,0,0,0.035) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.10;
  }

  .topic-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0,0,0,0.08);
  }

  .topic-icon {
    position: relative;
    width: 28px;
    height: 28px;
    opacity: 0.92;
  } 

  .topic-icon :dlobal(svg) {
    width: 100%;
    height: 100%;
  }

  .topic-title {
    position: relative;
    font-family: 'DM Serif Display', serif;
    font-size: 1.62rem;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 90%;
  }

  .topic-arrow {
    position: relative;
    font-size: 1.1rem;
    align-self: flex-end;
  }

  .daily-section {
    max-width: 1500px;
    margin: 34px auto 0;
    padding-top: 22px;
    border-top: 1px solid rgba(0,0,0,0.12);
  }

  .daily-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .daily-head p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.62rem;
    font-weight: 700;
    color: #7a7168;
  }

  .daily-head h2 {
    margin: 0;
    font-size: 0.96rem;
    font-weight: 600;
  }

  .daily-article-list {
    display: grid;
  }

  .daily-article-card {
    display: none;
    min-height: 190px;
    padding: 26px;
    border-radius: 20px;
    background: rgba(255,255,255,0.34);
    border: 1px solid rgba(0,0,0,0.10);
    color: #151515;
    text-decoration: none;
    box-shadow: 0 12px 28px rgba(0,0,0,0.045);
    justify-content: space-between;
    gap: 32px;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .daily-article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0,0,0,0.08);
  }

  .daily-meta {
    margin: 0 0 18px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.68rem;
    font-weight: 700;
    color: #7a7168;
  }

  .daily-article-card h3 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    margin: 0 0 14px;
  }

  .daily-article-card p {
    max-width: 760px;
    line-height: 1.65;
    color: #5d554d;
  }

  .daily-article-card span {
    align-self: flex-end;
    font-weight: 700;
    white-space: nowrap;
  }

  .daily-empty {
    padding: 24px;
    border-radius: 18px;
    background: rgba(255,255,255,0.28);
    border: 1px solid rgba(0,0,0,0.08);
    color: #6b6258;
  }

  @media (max-width: 1100px) {
    .topic-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .daily-head {
      display: block;
    }

    .daily-head h2 {
      margin-top: 8px;
    }

    .daily-article-card {
      flex-direction: column;
    }
  }

  @media (max-width: 620px) {
    .page {
      padding: 16px;
    }

    .hero {
      padding: 36px 0 34px;
    }

    .topic-grid {
      grid-template-columns: 1fr;
    }
  }

  .theme-toggle {
    width: 42px;
    height: 26px;
    border: 1px solid rgba(0,0,0,0.13);
    border-radius: 999px;
    background: rgba(255,255,255,0.35);
    color: #151515;
    display: grid;
    place-items: center;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition:
    background 0.35s ease,
    border-color 0.35s ease,
    color 0.35s ease,
    transform 0.18s ease;
}

.theme-toggle:hover {
  transform: translateY(-1px);
}

.theme-icon {
  position: absolute;
  font-size: 0.9rem;
  line-height: 1;
  transition:
    opacity 0.35s ease,
    transform 0.35s ease;
}

.theme-sun {
  opacity: 1;
  transform: translateY(12px) rotate(-30deg);
}

.theme-moon {
  opacity: 0;
  transform: translateY(0) rotate(0);
}

:global(html[data-theme='dark']) .theme-toggle {
  background: rgba(238,231,220,0.08);
  border-color: rgba(238,231,220,0.18);
  color: #eee7dc;
}

:global(html[data-theme='dark']) .theme-sun {
  opacity: 0;
  transform: translateY(12px) rotate(-30deg);
}

:global(html[data-theme='dark']) .theme-moon {
  opacity: 1;
  transform: translateY(0) rotate(0);
}

/* Dark Mode Feinschliff */

:global(html[data-theme='dark']) .menu span {
  background: #eee7dc;
}

:global(html[data-theme='dark']) .theme-toggle {
  width: 46px;
  height: 28px;
  background: rgba(238,231,220,0.08);
  border-color: rgba(238,231,220,0.22);
  color: #eee7dc;
}

:global(html[data-theme='dark']) .topic-card {
  filter: brightness(0.82) saturate(0.92);
}

:global(html[data-theme='dark']) .daily-article-card {
  background:
    linear-gradient(135deg, rgba(255,255,255,0.075), rgba(0,0,0,0.18)),
    #211f1b;
  border-color: rgba(238,231,220,0.14);
  color: #eee7dc;
}

:global(html[data-theme='dark']) .daily-article-card h3 {
  color: #eee7dc;
}

:global(html[data-theme='dark']) .daily-article-card p {
  color: #bdb2a3;
}

:global(html[data-theme='dark']) .daily-article-card .daily-meta {
  color: #d6b982;
}

:global(html[data-theme='dark']) .daily-article-card span {
  color: #eee7dc;
}

</style>