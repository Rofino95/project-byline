---
import Layout from '../layouts/Layout.astro';

const topics = [
  { title: 'Wirtschaft', icon: '▥', color: '#F3E3B2', text: '#7A5A13', link: '/themen/wirtschaft' },
  { title: 'Politik', icon: '▣', color: '#C9D8E8', text: '#1F4C72', link: '/themen/politik' },
  { title: 'Umwelt & Klima', icon: '◇', color: '#CEDDC8', text: '#315E3A', link: '/themen/umwelt-klima' },
  { title: 'Sport', icon: '↯', color: '#E4B8AE', text: '#7A2A22', link: '/themen/sport' },
  { title: 'Geschichte & Kultur', icon: '⌁', color: '#D8C1A8', text: '#5B3D22', link: '/themen/geschichte-kultur' },
  { title: 'Technik & Wissenschaft', icon: '⌬', color: '#C9C9C6', text: '#202020', link: '/themen/technik-wissenschaft' },
  { title: 'Mensch & Tier', icon: '◌', color: '#E7C1CB', text: '#743846', link: '/themen/mensch-tier' },
  { title: 'Tagebuch', icon: '≡', color: '#E8E3DC', text: '#746A60', link: '/themen/tagebuch' },
];
---

<Layout>
  <main class="page">
    <header class="topbar">
      <div class="brand">Project Byline</div>

      <button class="menu" aria-label="Menü">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>

    <section class="hero">
      <div class="hero-line"></div>
      <p class="eyebrow">Independent journalistic space</p>
      <h1>Project Byline</h1>
      <p class="subtitle">Everything in its right place</p>
    </section>

    <section class="section-head">
      <p>Dashboard</p>
      <h2>Themengebiete</h2>
    </section>

    <section class="topic-grid">
      {topics.map((topic) => (
        <a
          class="topic-card"
          href={topic.link}
          style={`--card-bg: ${topic.color}; --text: ${topic.text};`}
        >
          <span class="topic-icon">{topic.icon}</span>
          <span class="topic-title">{topic.title}</span>
          <span class="topic-arrow">→</span>
        </a>
      ))}
    </section>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap');

  :global(body) {
    margin: 0;
    background: #f4f1ec;
    color: #151515;
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
  }

  .page {
    min-height: 100vh;
    padding: 18px 34px 28px;
  }

  .topbar {
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(0,0,0,0.11);
  }

  .brand {
    font-family: 'DM Serif Display', serif;
    font-size: 1.28rem;
    letter-spacing: -0.02em;
  }

  .menu {
    width: 34px;
    height: 26px;
    border: 0;
    background: transparent;
    display: grid;
    gap: 4px;
    cursor: pointer;
    padding: 3px;
  }

  .menu span {
    display: block;
    height: 1.5px;
    background: #151515;
    border-radius: 999px;
  }

  .hero {
    position: relative;
    max-width: 1500px;
    margin: 0 auto;
    padding: 34px 0 30px;
    text-align: center;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0,0,0,0.035) 1px, transparent 1px),
      linear-gradient(rgba(0,0,0,0.025) 1px, transparent 1px);
    background-size: 46px 46px;
    opacity: 0.18;
    pointer-events: none;
  }

  .hero-line {
    position: relative;
    z-index: 1;
    width: 58px;
    height: 3px;
    background: #151515;
    margin: 0 auto 12px;
    border-radius: 999px;
  }

  .eyebrow {
    position: relative;
    z-index: 1;
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.58rem;
    font-weight: 700;
    color: #6b6258;
  }

  h1 {
    position: relative;
    z-index: 1;
    font-family: 'DM Serif Display', serif;
    font-size: clamp(4.2rem, 7.4vw, 7.8rem);
    line-height: 0.82;
    margin: 0;
    letter-spacing: -0.065em;
  }

  .subtitle {
    position: relative;
    z-index: 1;
    font-family: 'DM Serif Display', serif;
    font-style: italic;
    font-size: clamp(1.15rem, 1.8vw, 2rem);
    margin: 14px 0 0;
    color: #6b6258;
  }

  .section-head {
    max-width: 1500px;
    margin: 0 auto 14px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    border-top: 1px solid rgba(0,0,0,0.12);
    padding-top: 14px;
  }

  .section-head p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.62rem;
    font-weight: 700;
    color: #7a7168;
  }

  .section-head h2 {
    margin: 0;
    font-size: 0.96rem;
    font-weight: 600;
  }

  .topic-grid {
    max-width: 1500px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .topic-card {
    position: relative;
    min-height: 128px;
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.34), rgba(0,0,0,0.035)),
      var(--card-bg);
    color: var(--text);
    text-decoration: none;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 12px 28px rgba(0,0,0,0.045);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .topic-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0,0,0,0.045) 1px, transparent 1px),
      linear-gradient(rgba(0,0,0,0.035) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.10;
  }

  .topic-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0,0,0,0.08);
  }

  .topic-icon {
    position: relative;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .topic-title {
    position: relative;
    font-family: 'DM Serif Display', serif;
    font-size: 1.62rem;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 90%;
  }

  .topic-arrow {
    position: relative;
    font-size: 1.1rem;
    align-self: flex-end;
  }

  @media (max-width: 1100px) {
    .topic-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .page {
      padding: 16px;
    }

    .hero {
      padding: 36px 0 28px;
    }

    .topic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>