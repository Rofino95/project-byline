---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const topics = [
    {
      slug: 'wirtschaft',
      title: 'Wirtschaft',
      color: '#F3E3B2',
      text: '#7A5A13',
      description: 'Hintergründe, Analysen und Geschichten über Märkte und Unternehmen.',
    },
    {
      slug: 'politik',
      title: 'Politik',
      color: '#C9D8E8',
      text: '#1F4C72',
      description: 'Politische Entwicklungen, Debatten und Einordnungen.',
    },
    {
      slug: 'umwelt-klima',
      title: 'Umwelt & Klima',
      color: '#CEDDC8',
      text: '#315E3A',
      description: 'Texte über Umwelt, Klima und Nachhaltigkeit.',
    },
    {
      slug: 'sport',
      title: 'Sport',
      color: '#E4B8AE',
      text: '#7A2A22',
      description: 'Geschichten, Analysen und Beobachtungen aus dem Sport.',
    },
    {
      slug: 'geschichte-kultur',
      title: 'Geschichte & Kultur',
      color: '#D8C1A8',
      text: '#5B3D22',
      description: 'Geschichte, Kultur und gesellschaftliche Entwicklungen.',
    },
    {
      slug: 'technik-wissenschaft',
      title: 'Technik & Wissenschaft',
      color: '#C9C9C6',
      text: '#202020',
      description: 'Technologie, Wissenschaft und digitale Entwicklungen.',
    },
    {
      slug: 'mensch-tier',
      title: 'Mensch & Tier',
      color: '#E7C1CB',
      text: '#743846',
      description: 'Geschichten über Menschen, Tiere und Alltag.',
    },
    {
      slug: 'tagebuch',
      title: 'Tagebuch',
      color: '#E8E3DC',
      text: '#746A60',
      description: 'Persönliche Geschichten und Beobachtungen.',
    },
  ];

  const articles = await getCollection('articles');

  return topics.map((topic) => ({
    params: {
      slug: topic.slug,
    },
    props: {
      topic,
      articles: articles.filter(
        (article) => article.data.category === topic.slug
      ),
    },
  }));
}

const { topic, articles } = Astro.props;
---

<Layout>
  <main class="page">
    <header class="topbar">
      <a href="/" class="brand">Project Byline</a>

      <details class="menu-wrap">
        <summary class="menu" aria-label="Menü">
          <span></span>
          <span></span>
          <span></span>
        </summary>

        <nav class="menu-panel">
          <a href="/entdecken">Entdecken</a>
          <a href="/artikel">Alle Artikel</a>
          <a href="/autoren">Autor:innen</a>
          <a href="/ueber">Über Project Byline</a>
        </nav>
      </details>
    </header>

    <section
      class="hero"
      style={`--topic-bg:${topic.color}; --topic-text:${topic.text};`}
    >
      <p class="eyebrow">Themengebiet</p>
      <h1>{topic.title}</h1>
      <p class="description">{topic.description}</p>
    </section>

    <section class="articles">
      {articles.length > 0 ? (
        <div class="article-grid">
          {articles.map((article) => (
            <a
              class="article-card"
              href={`/artikel/${article.id.replace(/\.md$/, '')}`}
            >
              <p class="meta">{article.data.date}</p>
              <h2>{article.data.title}</h2>
              <p>{article.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">Noch keine Artikel vorhanden.</p>
      )}
    </section>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600&display=swap');

  :global(body) {
    margin: 0;
    background: #f4f1ec;
    color: #151515;
    font-family: 'Inter', sans-serif;
  }

  .page {
    padding: 24px;
    min-height: 100vh;
  }

  .topbar {
    max-width: 1400px;
    margin: 0 auto 22px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(0,0,0,0.10);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    font-family: 'DM Serif Display', serif;
    font-size: 1.25rem;
    color: #151515;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .menu {
    width: 34px;
    height: 26px;
    border: 0;
    background: transparent;
    display: grid;
    gap: 4px;
    cursor: pointer;
    padding: 3px;
  }

  .menu span {
    display: block;
    height: 1.5px;
    background: #151515;
    border-radius: 999px;
  }

  .hero {
    max-width: 1400px;
    margin: 0 auto 28px;
    border-radius: 22px;
    padding: 42px;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.34), rgba(0,0,0,0.03)),
      var(--topic-bg);
    color: var(--topic-text);
    border: 1px solid rgba(0,0,0,0.08);
  }

  .eyebrow {
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.65rem;
    font-weight: 700;
  }

  h1 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(4rem, 7vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    margin: 0;
  }

  .description {
    max-width: 700px;
    margin-top: 18px;
    line-height: 1.7;
  }

  .articles {
    max-width: 1400px;
    margin: 0 auto;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .article-card {
    display: block;
    padding: 24px;
    border-radius: 18px;
    text-decoration: none;
    color: #151515;
    background: rgba(255,255,255,0.35);
    border: 1px solid rgba(0,0,0,0.08);
    transition: 0.18s ease;
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(0,0,0,0.08);
  }

  .meta {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #7a7168;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .article-card h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 2rem;
    line-height: 1;
    margin: 0 0 14px;
    letter-spacing: -0.04em;
  }

  .article-card p {
    line-height: 1.6;
  }

  .empty-state {
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 18px;
    padding: 24px;
    background: rgba(255,255,255,0.35);
  }

  @media (max-width: 900px) {
    .article-grid {
      grid-template-columns: 1fr;
    }
  }
  
  .menu-wrap {
    position: relative;
  }

  .menu-wrap summary {
    list-style: none;
  }

  .menu-wrap summary::-webkit-details-marker {
   display: none;
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: 42px;
    z-index: 20;
    width: 220px;
    padding: 10px;
    border-radius: 16px;
    background: rgba(244, 241, 236, 0.96);
    border: 1px solid rgba(0,0,0,0.12);
    box-shadow: 0 18px 45px rgba(0,0,0,0.10);
    backdrop-filter: blur(12px);
  }

  .menu-panel a {
    display: block;
    padding: 12px;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: #151515;
    text-decoration: none;
  }

  .menu-panel a:hover {
    background: rgba(0,0,0,0.06);
  }
</style>